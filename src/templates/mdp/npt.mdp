title                   = NPT Equilibration for FXR-LIG
define                  = -DPOSRES  
integrator              = md
nsteps                  = 50000      
dt                      = 0.002
; Restrições e continuação
continuation            = yes        ; Continuação a partir do equilíbrio NVT
constraint_algorithm    = lincs
constraints             = h-bonds
; Barostato Moderno e Correto
pcoupl                  = c-rescale     ; Substituiu o Berendsen obsoletado
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
refcoord_scaling        = com           ; MATOU O WARNING 2 (Escalonamento pelo centro de massa)
; Termostato mantido
tcoupl                  = V-rescale
tc-grps                 = Protein_LIG Water_and_ions
tau_t                   = 0.1   0.1
ref_t                   = 310   310
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
pbc                     = xyz
gen_vel                 = no         ; Velocidades lidas a partir do arquivo de coordenadas/checkpoint NVT